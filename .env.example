# ghetemashin.ir — environment example
# cp .env.example .env.local  then fill real values
# Never commit real secrets

# ── Site (Vercel) ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ghetemashin.ir
# Public indexing: keep false until catalog/content is ready. robots.ts disallows all until true.
# Set true in Vercel Production when going public: NEXT_PUBLIC_ALLOW_INDEX=true
NEXT_PUBLIC_ALLOW_INDEX=false
# Optional extra CSRF origins (comma-separated), e.g. preview URLs
CSRF_TRUSTED_ORIGINS=

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (product images + backups) ───────────────
# Account ID from Cloudflare dashboard → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ghetemashin-media
# Public base URL for objects (custom domain on R2 or *.r2.dev)
# Example custom domain: https://media.ghetemashin.ir
R2_PUBLIC_BASE_URL=

# ── Sharp image pipeline ───────────────────────────────────
# No separate worker env: Sharp runs in the Next.js/Vercel app
# (src/lib/process-product-image.ts). Watermark loads from
# public/brand/logo-light-transparent.webp (or NEXT_PUBLIC_SITE_URL/brand/…).
# Ensure sharp is installed (package.json dependency) — no extra env vars.

# ── Upstash Redis (rate limit / lockout) ───────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── Cron / server security ─────────────────────────────────
# Required for /api/cron/backup, expire-reservations, jobs, orphan-media
# Same value in Vercel; cron calls use Authorization: Bearer …
CRON_SECRET=

# ── OTP ────────────────────────────────────────────────────
OTP_PEPPER=
OTP_TTL_SECONDS=300

# ── SMS (Melipayamak) — optional until launch ──────────────
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_BODY_ID=
ADMIN_SMS_PHONES=
MELIPAYAMAK_BODY_OTP_LOGIN=
MELIPAYAMAK_BODY_ORDER_PLACED=
MELIPAYAMAK_BODY_ORDER_NEW_ADMIN=
MELIPAYAMAK_BODY_PAYMENT_SUCCESS=
MELIPAYAMAK_BODY_PAYMENT_FAILED=
MELIPAYAMAK_BODY_SHIPPED=
MELIPAYAMAK_BODY_TRACKING_CODE=
MELIPAYAMAK_BODY_ORDER_CANCELLED=
MELIPAYAMAK_BODY_ADMIN_CRITICAL=

# ── Payment (Zarinpal) — optional until gateway go-live ────
ZARINPAL_MERCHANT_ID=
PAYMENT_TEST_MODE=true

# ── SEO optional ───────────────────────────────────────────
INDEXNOW_KEY=

# ── OpenAI optional (admin SEO assist) ─────────────────────
OPENAI_API_KEY=
OPENAI_SEO_MODEL=gpt-4o-mini

# ── Transactional email (Resend) ───────────────────────────
# Without RESEND_API_KEY, order/alert emails fail-soft (skipped).
RESEND_API_KEY=
EMAIL_FROM=قطعه ماشین <noreply@ghetemashin.ir>
# Optional alias (send.ts also reads RESEND_FROM if EMAIL_FROM empty)
# RESEND_FROM=
